[Unit]
Description=MirrorLink-Pi virtual X display (Xvfb on :99)
# Pi OS Lite has no real X server. We provide one via Xvfb so x11vnc has a screen
# to share with the head unit. The resolution matches a typical car HU (800×480);
# the head unit will scale anyway.
After=mlpi-gadget.service
PartOf=mlpi.target

[Service]
Type=simple
User=mlpi
Environment=HOME=/home/mlpi
ExecStartPre=/bin/sh -c 'rm -f /tmp/.X99-lock /tmp/.X11-unix/X99'
ExecStart=/usr/bin/Xvfb :99 -screen 0 800x480x24 -ac -nolisten tcp
ExecStartPost=/bin/sh -c 'for i in 1 2 3 4 5 6 7 8; do [ -S /tmp/.X11-unix/X99 ] && exit 0; sleep 0.5; done; exit 1'
ExecStartPost=/usr/bin/xsetroot -display :99 -solid steelblue
# Open one xterm so the head unit sees something obviously alive on first connect.
# We background the xterm so the ExecStartPost returns; xterm dies when Xvfb exits.
ExecStartPost=/bin/sh -c '/usr/bin/xterm -display :99 -geometry 80x24+10+10 -fa Monospace -fs 14 -title MirrorLink-Pi -e "echo MirrorLink Pi VNC ready; echo; while true; do date; sleep 1; done" &'
Restart=on-failure
RestartSec=2

[Install]
WantedBy=mlpi.target
