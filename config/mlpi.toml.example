# MirrorLink-Pi settings.
#
# On the SD card this file lives on the boot partition as /boot/firmware/mlpi.toml,
# so you can edit it from any laptop (Windows/macOS/Linux) without mounting ext4.
# Everything is optional — delete a line to get the built-in default shown here.
#
# Load order: defaults → /etc/mlpi/mlpi.toml → /boot/firmware/mlpi.toml
#             → ./config/mlpi.toml → --config FILE → MLPI_* environment variables

[experiment]
# "rotate": try the next variant from config/variants.toml on every new connection
#           attempt of the car, until one makes it open the VNC connection.
# "fixed":  always use fixed_variant.
mode = "rotate"
fixed_variant = "spec-1.0"
# Handshake cycles (descriptor → profile → app list) each variant gets before the
# next one is tried. The MIB2 loops every ~2.7 s.
cycles_per_variant = 2

[usb]
# Some head units only talk to whitelisted USB vendors (Samsung 0x04e8, HTC 0x0bb4,
# LG 0x1004, Sony 0x054c). The VW MIB II talked to the default below in every session.
vid = "0x1d6b"
pid = "0x0104"
function = "ncm"            # ncm | ecm | rndis
address = "192.168.7.2/24"  # static address of usb0 on the Pi
# Answer the MirrorLink USB command via a FunctionFS interface (experimental,
# off by default). Enable only after the plain gadget works, then reboot.
ml_command = false

# Phone mode (docs/phone-mode.md): mirror an Android phone with scrcpy over the Pi's
# own Wi-Fi hotspot. `prepare-sd.sh --phone` appends an active [phone] section with a
# random Wi-Fi password; these are the other settings you can add to it:
# [phone]
# enabled = true
# wifi_ssid = "MirrorLink-Pi"
# wifi_password = "..."          # 8-63 characters
# wifi_country = "DE"
# apps = [{name = "Waze", package = "com.waze", colour = "#33ccff"}]   # launcher tiles (max 7)
# start_app = ""                 # open this app directly instead of the Pi launcher
# dpi = 120                      # 120 = apps use landscape layouts; bigger = larger UI
# max_fps = 30
# bit_rate = 4000000
# decoder = ""                   # "h264_v4l2m2m" = try the Pi's hardware decoder
# max_lag = 2.0                  # s behind the phone before skipping to a new keyframe
# home_button = "right"         # right | left | top-left | top-right | bottom-left | bottom-right | off

[dhcp]
client_address = "192.168.7.44"   # what the car gets (same as all earlier sessions)

[vnc]
width = 800
height = 480

[watchdog]
# Soft re-plug the USB gadget when the car has been silent this long (0 = never).
idle_reconnect_seconds = 90
max_reconnects = 20

[led]
enabled = true

[network]
interface = "usb0"
http_port = 8080
vnc_port = 5900

[ssdp]
# Stable UUID — matches Robert's original code so head units that cached us still recognize us.
device_uuid = "c8cba096-5abe-47ac-9c14-3267d7c94ce6"

[device]
friendly_name = "MirrorLink Pi"
manufacturer  = "Sirnicki & Maksymilian"

[logging]
level = "DEBUG"
